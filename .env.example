# Copy to .env and adjust. docker compose reads .env automatically.

POSTGRES_USER=driftline
POSTGRES_PASSWORD=driftline
POSTGRES_DB=driftline

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=driftline-artifacts

# Leave empty to disable a channel.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
ALERT_COOLDOWN=30m

# Protects /api/v1. Leave empty for local development; set a long random value
# anywhere shared. The dashboard and scripts read it too (DRIFTLINE_API_KEY).
API_KEY=

# Drift engine
DRIFT_INTERVAL=1m
DRIFT_WINDOW=15m
DRIFT_MIN_SAMPLES=100

# Roll back unhealthy canaries automatically (false = alert only)
AUTO_ROLLBACK=true

GRAFANA_ADMIN_PASSWORD=admin
