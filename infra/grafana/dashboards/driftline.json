          "expr": "sum by (model, version, role) (rate(driftline_predictions_total{outcome=\"ok\"}[1m]))",
          "legendFormat": "{{model}} {{version}} ({{role}})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
